{
  "name": "ai-exam-platform-desktop",
  "version": "1.0.0",
  "private": true,
  "description": "Windows desktop application for AI Exam Platform",
  "main": "electron/main.js",
  "scripts": {
    "desktop": "electron .",
    "desktop:build:frontend": "npm --prefix frontend run build",
    "desktop:build:backend": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-backend.ps1",
    "dist:win": "npm run desktop:build:frontend && npm run desktop:build:backend && electron-builder --win nsis"
  },
  "devDependencies": {
    "electron": "^37.2.6",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.aiexamplatform.desktop",
    "productName": "AI Exam Platform",
    "directories": {
      "output": "dist"
    },
    "files": [
      "electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "frontend/.next/standalone",
        "to": "frontend"
      },
      {
        "from": "frontend/.next/standalone/node_modules",
        "to": "frontend/node_modules",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "frontend/.next/static",
        "to": "frontend/.next/static"
      },
      {
        "from": "frontend/public",
        "to": "frontend/public"
      },
      {
        "from": "backend/dist/aiexam-backend",
        "to": "backend"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "AI Exam Platform",
      "artifactName": "AI Exam Platform Setup.exe"
    }
  }
}